rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Citizen report uploads (photos / voice). Tighten later with Auth + App Check.
    match /villages/{villageId}/complaints/{complaintId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 15 * 1024 * 1024;
    }
  }
}
