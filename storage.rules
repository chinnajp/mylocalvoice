rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /villages/{villageId}/complaints/{complaintId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|audio/.*|video/.*|application/octet-stream');
    }
  }
}
