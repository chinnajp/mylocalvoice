# Copy to .env for local development
#
# --- Option A: Local emulators ---
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-mylocalvoice.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-mylocalvoice
VITE_FIREBASE_STORAGE_BUCKET=demo-mylocalvoice.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:mylocalvoice
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_VILLAGE_ID=thiruppair
VITE_USE_MOCK_DATA=false
VITE_USE_FIREBASE_EMULATOR=true
# Spark plan: leave Cloud Functions off; use local demo OTP unless testing Vercel API
VITE_USE_CLOUD_FUNCTIONS=false
VITE_USE_OTP_API=false

# --- Option B: Real Firebase cloud (Spark OK) + Vercel OTP API ---
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=mylocalvoice-a73f4.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mylocalvoice-a73f4
VITE_FIREBASE_STORAGE_BUCKET=mylocalvoice-a73f4.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_VILLAGE_ID=thiruppair
VITE_USE_MOCK_DATA=false
VITE_USE_FIREBASE_EMULATOR=false
VITE_USE_CLOUD_FUNCTIONS=false
VITE_USE_OTP_API=true

# --- Vercel server env (Project Settings → Environment Variables) — NOT VITE_* ---
# OTP_SECRET=long-random-string
# SMS_PROVIDER=console
# SMS_PROVIDER=fast2sms|msg91|twilio
# SMS_API_KEY=...
